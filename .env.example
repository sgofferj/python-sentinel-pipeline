# ----- Copernicus Dataspace Account (Required for search/download)
COPERNICUS_USERNAME = "your-email@example.com"
COPERNICUS_PASSWORD = "your-password"

# ----- General Configuration
PIPELINES = "S1,S2,FUSION"  # S1: Radar, S2: Optical, FUSION: Cross-sensor products
DATA_DIR = "."  # Base directory for 'temp/' and default 'output/'
TARGET_DIR = "./output"  # Absolute path for output, overrides DATA_DIR/output
USE_LOG = True  # Skip products already processed (uses search_log.json)
CLEANUP_AFTER_RUN = False  # Automatically delete old raw data
CLEANUP_DAYS = 30  # Keep raw data for this many days
CLEANUP_ROI_DAYS = 30  # Keep ROI crops for this many days (can be longer than standard)
# CLEANUP_S1_DAYS =                                  # Override CLEANUP_DAYS for Sentinel-1 only (optional)
# CLEANUP_S2_DAYS =                                  # Override CLEANUP_DAYS for Sentinel-2 only (optional)
# CLEANUP_S3_DAYS =                                  # Override CLEANUP_DAYS for Sentinel-3 only (optional)
# CLEANUP_S2_VERSIONS =                              # Keep at most N S2 products per UTM tile (overrides CLEANUP_S2_DAYS)
# CLEANUP_FUSION_DAYS =                              # Override CLEANUP_DAYS for fusion products only (optional)
CLEANUP_RAW = True  # Delete source .SAFE directories immediately after processing
EXECUTE_AFTER_PIPELINE = (
    ""  # Optional command/script to run after pipeline (e.g., rsync)
)

# ----- Performance & Hardware
PIPELINE_WORKERS = 2  # Concurrent threads for warping and math (recom: 2 for 16GB RAM)
MAX_PARALLEL_FINALIZERS = 2  # Concurrent COG/Sidecar generation tasks
DISABLE_GPU = False  # Set to True to force CPU-only even if CuPy/CUDA is present
ENABLE_GPU_WARP = (
    False  # Set to True to use experimental CUDA warping for S1 (highly unstable)
)

# ----- Notifications
APPRISE_URLS = ""  # Apprise URIs (e.g., discord://webhookid/webhooktoken)

# ----- Sentinel-1 (Radar) Parameters
S1_BOX = "24.46,60.08,25.45,60.34"  # Search area: East, South, West, North
S1_FORECAST_PASSES = 2  # Number of overflight passes to forecast (GeoJSON overlays)
S1_STARTDATE = "2025-08-01"  # Defaults to yesterday if omitted
S1_MAXRECORDS = 5  # Max products to download per box
S1_PRODUCTTYPE = "GRD"  # GRD is standard for backscatter
S1_SENSORMODE = "IW"  # IW is standard for land-based interferometric wide swath
S1_PROCESSES = "VV,VH,RATIOVVVH,AIS"  # VV, VH (Greyscale), RATIOVVVH (Pseudocolor), AIS (vessel overlay)

# ----- Sentinel-2 (Optical) Parameters
S2_BOX = "24.46,60.08,25.45,60.34"  # Search area: East, South, West, North
S2_FORECAST_PASSES = 2  # Number of overflight passes to forecast (GeoJSON overlays)
S2_STARTDATE = "2025-08-01"  # Defaults to yesterday if omitted
S2_MAXRECORDS = 5  # Max products to download per box
S2_CLOUDCOVER = 5  # Max cloud percentage (0-100)
S2_PRODUCTTYPE = "L2A"  # L2A (Bottom of Atmosphere) is recommended
S2_PROCESSES = "TCI,NIRFC,AP,NDVI,NDBI,NDBI_CLEAN,NDRE,NBR,CAMO"
# S2 Options:
# TCI: True Color, NIRFC: False Color, AP: Atmospheric Penetration
# NDVI: Vegetation, NDBI: Urban/Built-up, NDBI_CLEAN: OSINT building index
# NDRE: Red Edge (Chlorophyll), NBR: Burn Ratio, CAMO: Custom OSINT discovery
# AIS: Optional AIS overlay on TCI (primary use case is S1 RATIO-AIS)
# TCI-GF: Guided-filtered True Color (uses NIR B08 guidance)
# NIRFC-GF: Self-guided filtered False Color

# --- AIS Correlator (primary: S1-RATIO, optional: S2-TCI)
# Plots vessel metadata onto imagery to identify ships sailing dark or transmitting false coordinates.
# Requires a running python-ais-recorder instance (https://github.com/sgofferj/python-ais-recorder).
AIS_RECORDER_URL = "http://your-ais-recorder:8108"
AIS_MAX_TIME_MINUTES = 30  # Search window for AIS reports (+/- from acquisition)

# ----- Guided Filter (Edge-preserving smoothing for S2 visual products)
# Applied per-product via TCI-GF / NIRFC-GF in S2_PROCESSES.
GF_RADIUS = 2  # Local window radius (pixels, 1-8)
GF_EPSILON = 0.01  # Edge-preservation threshold (higher = smoother)
GF_GUIDANCE = "B08"  # "B08" (NIR-guided) or "self" (self-guided)
GF_DETAIL_STRENGTH = 2.0  # -1=base only, 0=unchanged, 1=standard, 2=aggressive

# ----- Sentinel-3 (Fire Detection) Parameters
S3_BOX = "24.46,60.08,25.45,60.34"  # Search area: West, South, East, North
S3_STARTDATE = "2025-08-01"  # Defaults to yesterday if omitted
S3_MAXRECORDS = 5  # Max products to download per box
S3_PRODUCTTYPE = "SL_1_RBT___"  # SLSTR L1 radiances/BT (primary)
S3_SENSORMODE = "NRT"  # Timeliness: NT (NTC) or NRT
S3_PROCESSES = "BT,FIRE"  # Output products
# S3 Options:
# BT: Brightness temperature false-colour composite (S8/S7/S9)
# FIRE: Thermal anomaly detection with hot-body palette

# ----- Fusion Parameters
FUSION_PROCESSES = "RADAR-BURN,LIFE-MACHINE,TARGET-PROBE-V2"
# Fusion Options:
# RADAR-BURN: S1-VH + S2-TCI
# LIFE-MACHINE: S1-VH + S2-TCI + S2-NIRFC
# TARGET-PROBE-V2: S1-VH + S2-TCI + S2-NDBI + S2-NDRE
